rules_version = '2';

// Skillbee Deutsch Games — Live Class Mode security rules.
// "Good enough, zero setup" model: no sign-in, but the database STRUCTURE is
// locked down so nobody can tamper with other rooms, overwrite answers, or
// inflate the scoreboard from outside. Residual risk (accepted): someone who
// already knows a room code could answer as a classmate or advance the game.
service cloud.firestore {
  match /databases/{database}/documents {

    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    // ---- Rosters: reusable class lists (no accounts, so validated-but-open) ----
    match /rosters/{rosterId} {
      allow read: if true;
      allow create, update: if
        shortStr(request.resource.data.name, 80) &&
        request.resource.data.students is list &&
        request.resource.data.students.size() <= 80;
      allow delete: if true;
    }

    // ---- Sessions: one live game room, keyed by its 4-char code ----
    match /sessions/{room} {
      allow read: if true;

      allow create: if
        shortStr(request.resource.data.gameId, 40) &&
        request.resource.data.status is string &&
        request.resource.data.students is list &&
        request.resource.data.students.size() <= 80;

      // The host advances the game and writes scores. Without accounts we can't
      // cryptographically prove "host", so we constrain shape/size and never
      // allow the room to be deleted.
      allow update: if
        request.resource.data.status is string &&
        request.resource.data.students is list &&
        request.resource.data.students.size() <= 80;

      allow delete: if false;

      // ---- Answers: one document per student per question, write-once ----
      match /answers/{answerId} {
        allow read: if true;

        // Can only be created while its question is the live one, and can never
        // be changed or deleted afterwards (so nobody edits an answer later).
        allow create: if
          request.resource.data.studentId is string &&
          request.resource.data.questionIndex is int &&
          get(/databases/$(database)/documents/sessions/$(room)).data.status == 'question' &&
          request.resource.data.questionIndex == get(/databases/$(database)/documents/sessions/$(room)).data.round.index;

        allow update, delete: if false;
      }

      // ---- Joined: one document per claimed roster slot, sessions/{room}/joined/{studentId}.
      // This is the SERVER-SIDE backstop for the name-claim race: even a client
      // that bypasses the app's transaction cannot steal a name that is already
      // held with a fresh heartbeat. A slot frees up once its heartbeat is older
      // than 15s (a disconnected student's phone stops sending heartbeats).
      match /joined/{studentId} {
        allow read: if true;

        // Claiming a FREE slot: a create only happens when no document exists, so
        // it is by definition nobody's name yet. Validate shape.
        allow create: if
          shortStr(request.resource.data.name, 80) &&
          request.resource.data.owner is string &&
          request.resource.data.heartbeat is timestamp;

        // Update = the OWNER device refreshing its heartbeat / re-claiming, OR
        // anyone reclaiming a slot whose heartbeat has gone stale (owner gone). A
        // fresh slot can NEVER be taken over by a DIFFERENT device — that's the
        // server-side backstop for the name-claim race.
        allow update: if
          shortStr(request.resource.data.name, 80) &&
          request.resource.data.owner is string &&
          request.resource.data.heartbeat is timestamp && (
            request.resource.data.owner == resource.data.owner ||
            resource.data.heartbeat < request.time - duration.value(15, 's')
          );

        // Leaving (tab close / explicit leave) frees the slot immediately.
        allow delete: if true;
      }
    }

    // ---- Shared content bank (words, sentences, cases, compounds) ----
    // Synced across every device so teachers don't pass files around. No
    // accounts, so validated-but-open (edits are gated by the teacher PIN in
    // the app); a single small document, well under Firestore's 1MB limit.
    match /content/{doc} {
      allow read: if true;
      // updatedAt may be a millisecond NUMBER (what the app writes) or a
      // serverTimestamp (`timestamp`) — accept both. Requiring only `is number`
      // silently rejected every write whose updatedAt was a server timestamp,
      // which is why content stopped syncing.
      allow write: if request.resource.data.data is map &&
        (request.resource.data.updatedAt is number || request.resource.data.updatedAt is timestamp) &&
        request.resource.data.clientId is string;
    }

    // ---- App config: the teacher PIN (stored hashed, not plaintext) ----
    match /config/{doc} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['pin']) &&
        request.resource.data.pin is string && request.resource.data.pin.size() <= 64;
    }

    // (The cross-session "term leaderboard" feature was removed — student
    // performance is never persisted across rooms — so the /leaderboards
    // collection is no longer used or allowed. Re-publish these rules to drop
    // access to it entirely; leaving it has no effect since nothing reads it.)
  }
}
